<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

  <!--
    agnes::pointer<T*...> where:
      - all T* are the same type or AGNES_POINTER_NO_CONST_EVAL != 0.

    If AGNES_POINTER_NO_CONST_EVAL == 0, the underlying agnes::internal_::pointer_tuple<T...> will have member
      std::array<std::tuple_element_t<0, std::tuple<T...>>*, sizeof...(T)> ptrs_;

    If AGNES_POINTER_NO_CONST_EVAL != 0, the underlying agnes::internal_::pointer_tuple<T...> will have member
      std::array<void*, sizeof...(T)> ptrs_;
  -->

  <Type Name="agnes::pointer&lt;*&gt;">
    <Intrinsic Name="require_homogeneous" Expression="sizeof(impl_.ptrs_.ptrs_._Elems) != 0"/>
    <Intrinsic Name="homogeneous_ptr_at" Expression="impl_.ptrs_.ptrs_._Elems[i]">
      <Parameter Name="i" Type="int"/>
    </Intrinsic>
    <Intrinsic Name="homogeneous_ptr00" Expression="($T1 )homogeneous_ptr_at( 0) + impl_.i_"/>
    <Intrinsic Name="homogeneous_ptr01" Expression="($T2 )homogeneous_ptr_at( 1) + impl_.i_" Optional="true"/>
    <Intrinsic Name="homogeneous_ptr02" Expression="($T3 )homogeneous_ptr_at( 2) + impl_.i_" Optional="true"/>
    <Intrinsic Name="homogeneous_ptr03" Expression="($T4 )homogeneous_ptr_at( 3) + impl_.i_" Optional="true"/>
    <Intrinsic Name="homogeneous_ptr04" Expression="($T5 )homogeneous_ptr_at( 4) + impl_.i_" Optional="true"/>
    <Intrinsic Name="homogeneous_ptr05" Expression="($T6 )homogeneous_ptr_at( 5) + impl_.i_" Optional="true"/>
    <Intrinsic Name="homogeneous_ptr06" Expression="($T7 )homogeneous_ptr_at( 6) + impl_.i_" Optional="true"/>
    <Intrinsic Name="homogeneous_ptr07" Expression="($T8 )homogeneous_ptr_at( 7) + impl_.i_" Optional="true"/>
    <Intrinsic Name="homogeneous_ptr08" Expression="($T9 )homogeneous_ptr_at( 8) + impl_.i_" Optional="true"/>
    <Intrinsic Name="homogeneous_ptr09" Expression="($T10)homogeneous_ptr_at( 9) + impl_.i_" Optional="true"/>
    <Intrinsic Name="homogeneous_ptr10" Expression="($T11)homogeneous_ptr_at(10) + impl_.i_" Optional="true"/>
    <Intrinsic Name="homogeneous_ptr11" Expression="($T12)homogeneous_ptr_at(11) + impl_.i_" Optional="true"/>
    <Intrinsic Name="homogeneous_ptr12" Expression="($T13)homogeneous_ptr_at(12) + impl_.i_" Optional="true"/>
    <Intrinsic Name="homogeneous_ptr13" Expression="($T14)homogeneous_ptr_at(13) + impl_.i_" Optional="true"/>
    <Intrinsic Name="homogeneous_ptr14" Expression="($T15)homogeneous_ptr_at(14) + impl_.i_" Optional="true"/>
    <Intrinsic Name="homogeneous_ptr15" Expression="($T16)homogeneous_ptr_at(15) + impl_.i_" Optional="true"/>
    <Intrinsic Name="homogeneous_is_null" Expression="homogeneous_ptr00() == nullptr"/>
    <DisplayString Condition="homogeneous_is_null()">{{ null }}</DisplayString>
    <DisplayString Condition="(sizeof($T5) != 0)" Optional="true">{homogeneous_ptr00()}, {homogeneous_ptr01()}, {homogeneous_ptr02()}, {homogeneous_ptr03()}, ...</DisplayString>
    <DisplayString                                Optional="true">{homogeneous_ptr00()}, {homogeneous_ptr01()}, {homogeneous_ptr02()}, {homogeneous_ptr03()}</DisplayString>
    <DisplayString                                Optional="true">{homogeneous_ptr00()}, {homogeneous_ptr01()}, {homogeneous_ptr02()}</DisplayString>
    <DisplayString                                Optional="true">{homogeneous_ptr00()}, {homogeneous_ptr01()}</DisplayString>
    <DisplayString                                Optional="true">{homogeneous_ptr00()}</DisplayString>
    <Expand>
      <Item Name= "&lt;0&gt;"                >homogeneous_ptr00()</Item>
      <Item Name= "&lt;1&gt;" Optional="true">homogeneous_ptr01()</Item>
      <Item Name= "&lt;2&gt;" Optional="true">homogeneous_ptr02()</Item>
      <Item Name= "&lt;3&gt;" Optional="true">homogeneous_ptr03()</Item>
      <Item Name= "&lt;4&gt;" Optional="true">homogeneous_ptr04()</Item>
      <Item Name= "&lt;5&gt;" Optional="true">homogeneous_ptr05()</Item>
      <Item Name= "&lt;6&gt;" Optional="true">homogeneous_ptr06()</Item>
      <Item Name= "&lt;7&gt;" Optional="true">homogeneous_ptr07()</Item>
      <Item Name= "&lt;8&gt;" Optional="true">homogeneous_ptr08()</Item>
      <Item Name= "&lt;9&gt;" Optional="true">homogeneous_ptr09()</Item>
      <Item Name="&lt;10&gt;" Optional="true">homogeneous_ptr10()</Item>
      <Item Name="&lt;11&gt;" Optional="true">homogeneous_ptr11()</Item>
      <Item Name="&lt;12&gt;" Optional="true">homogeneous_ptr12()</Item>
      <Item Name="&lt;13&gt;" Optional="true">homogeneous_ptr13()</Item>
