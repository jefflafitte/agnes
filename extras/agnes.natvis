  <!--
    agnes::pointer<T*...> where:
      - all T* are not the same type
      - AGNES_POINTER_NO_CONST_EVAL == 0
      - AGNES_POINTER_NON_CONST_EVAL_OPTIMIZATION != 0.

    The underlying agnes::internal_::pointer_tuple<T0, T...> will have members
      T0*                               ptr0_;
      union
      {
      	std::array<void*, sizeof...(T)> aptrs_;
      	std::tuple<T*...>               tptrs_;
      };
      const bool                        aptrs_active_;
  -->

  <Type Name="agnes::pointer&lt;*&gt;">
    <Intrinsic Name="require_optimized_heterogeneous" Expression="sizeof(impl_.ptrs_.aptrs_active_) != 0"/>
    <Intrinsic Name="optimized_heterogeneous_ptr_at" Expression="(i == 0) ? impl_.ptrs_.ptr0_ : (impl_.ptrs_.aptrs_active_ ? impl_.ptrs_.aptrs_._Elems[i - 1] : ((void**)&amp;impl_.ptrs_.tptrs_)[sizeof(impl_.ptrs_.tptrs_)/sizeof(void*) - i])">
      <Parameter Name="i" Type="int"/>
    </Intrinsic>
    <Intrinsic Name="optimized_heterogeneous_ptr00" Expression="($T1 )optimized_heterogeneous_ptr_at( 0) + impl_.i_"/>
    <Intrinsic Name="optimized_heterogeneous_ptr01" Expression="($T2 )optimized_heterogeneous_ptr_at( 1) + impl_.i_" Optional="true"/>
    <Intrinsic Name="optimized_heterogeneous_ptr02" Expression="($T3 )optimized_heterogeneous_ptr_at( 2) + impl_.i_" Optional="true"/>
    <Intrinsic Name="optimized_heterogeneous_ptr03" Expression="($T4 )optimized_heterogeneous_ptr_at( 3) + impl_.i_" Optional="true"/>
    <Intrinsic Name="optimized_heterogeneous_ptr04" Expression="($T5 )optimized_heterogeneous_ptr_at( 4) + impl_.i_" Optional="true"/>
    <Intrinsic Name="optimized_heterogeneous_ptr05" Expression="($T6 )optimized_heterogeneous_ptr_at( 5) + impl_.i_" Optional="true"/>
    <Intrinsic Name="optimized_heterogeneous_ptr06" Expression="($T7 )optimized_heterogeneous_ptr_at( 6) + impl_.i_" Optional="true"/>
    <Intrinsic Name="optimized_heterogeneous_ptr07" Expression="($T8 )optimized_heterogeneous_ptr_at( 7) + impl_.i_" Optional="true"/>
    <Intrinsic Name="optimized_heterogeneous_ptr08" Expression="($T9 )optimized_heterogeneous_ptr_at( 8) + impl_.i_" Optional="true"/>
    <Intrinsic Name="optimized_heterogeneous_ptr09" Expression="($T10)optimized_heterogeneous_ptr_at( 9) + impl_.i_" Optional="true"/>
    <Intrinsic Name="optimized_heterogeneous_ptr10" Expression="($T11)optimized_heterogeneous_ptr_at(10) + impl_.i_" Optional="true"/>
    <Intrinsic Name="optimized_heterogeneous_ptr11" Expression="($T12)optimized_heterogeneous_ptr_at(11) + impl_.i_" Optional="true"/>
    <Intrinsic Name="optimized_heterogeneous_ptr12" Expression="($T13)optimized_heterogeneous_ptr_at(12) + impl_.i_" Optional="true"/>
    <Intrinsic Name="optimized_heterogeneous_ptr13" Expression="($T14)optimized_heterogeneous_ptr_at(13) + impl_.i_" Optional="true"/>
    <Intrinsic Name="optimized_heterogeneous_ptr14" Expression="($T15)optimized_heterogeneous_ptr_at(14) + impl_.i_" Optional="true"/>
    <Intrinsic Name="optimized_heterogeneous_ptr15" Expression="($T16)optimized_heterogeneous_ptr_at(15) + impl_.i_" Optional="true"/>
    <Intrinsic Name="optimized_heterogeneous_is_null" Expression="optimized_heterogeneous_ptr00() == nullptr"/>
    <DisplayString Condition="optimized_heterogeneous_is_null()">{{ null }}</DisplayString>
    <DisplayString Condition="sizeof($T5) != 0" Optional="true">{optimized_heterogeneous_ptr00()}, {optimized_heterogeneous_ptr01()}, {optimized_heterogeneous_ptr02()}, {optimized_heterogeneous_ptr03(), ...}</DisplayString>
