  <!--
    agnes::contiguous_base<Allocator, T...> where:
      - all T are the same type or AGNES_POINTER_NO_CONST_EVAL != 0.

    If AGNES_POINTER_NO_CONST_EVAL == 0, the underlying agnes::internal_::pointer_tuple<T...> instances will have member
      std::array<std::tuple_element_t<0, std::tuple<T...>>*, sizeof...(T)> ptrs_;

    If AGNES_POINTER_NO_CONST_EVAL != 0, the underlying agnes::internal_::pointer_tuple<T...> instances will have member
      std::array<void*, sizeof...(T)> ptrs_;

    Inherited by agnes::vector and agnes::table.
  -->

  <Type Name="agnes::internal_::contiguous_base&lt;*&gt;" Inheritable="true">
    <Intrinsic Name="require_homogeneous" Expression="sizeof(first_.p_.impl_.ptrs_.ptrs_._Elems) != 0"/>
    <Intrinsic Name="homogeneous_first_at" Expression="first_.p_.impl_.ptrs_.ptrs_._Elems[i]">
      <Parameter Name="i" Type="int"/>
    </Intrinsic>
    <Intrinsic Name="homogeneous_first00" Expression="($T2* )homogeneous_first_at( 0) + first_.p_.impl_.i_"/>
    <Intrinsic Name="homogeneous_first01" Expression="($T3* )homogeneous_first_at( 1) + first_.p_.impl_.i_" Optional="true"/>
    <Intrinsic Name="homogeneous_first02" Expression="($T4* )homogeneous_first_at( 2) + first_.p_.impl_.i_" Optional="true"/>
    <Intrinsic Name="homogeneous_first03" Expression="($T5* )homogeneous_first_at( 3) + first_.p_.impl_.i_" Optional="true"/>
    <Intrinsic Name="homogeneous_first04" Expression="($T6* )homogeneous_first_at( 4) + first_.p_.impl_.i_" Optional="true"/>
    <Intrinsic Name="homogeneous_first05" Expression="($T7* )homogeneous_first_at( 5) + first_.p_.impl_.i_" Optional="true"/>
    <Intrinsic Name="homogeneous_first06" Expression="($T8* )homogeneous_first_at( 6) + first_.p_.impl_.i_" Optional="true"/>
    <Intrinsic Name="homogeneous_first07" Expression="($T9* )homogeneous_first_at( 7) + first_.p_.impl_.i_" Optional="true"/>
    <Intrinsic Name="homogeneous_last00" Expression="($T2* )last_.p_.impl_.ptrs_.ptrs_._Elems[0] + last_.p_.impl_.i_"/>
    <Intrinsic Name="homogeneous_cap00"  Expression="($T2* ) cap_.p_.impl_.ptrs_.ptrs_._Elems[0] +  cap_.p_.impl_.i_"/>
    <Intrinsic Name="homogeneous_size"     Expression="homogeneous_last00() - homogeneous_first00()"/>
    <Intrinsic Name="homogeneous_capacity" Expression="homogeneous_cap00()  - homogeneous_first00()"/>
    <DisplayString>{{ size={homogeneous_size()} }}</DisplayString>
    <Expand>
      <Item Name="[capacity]" ExcludeView="simple">homogeneous_capacity()</Item>
      <Item Name="[allocator]" ExcludeView="simple">alloc_</Item>
      <Synthetic Name="&lt;0&gt;">
        <Expand>
          <ArrayItems>
            <Size>homogeneous_size()</Size>
            <ValuePointer>homogeneous_first00()</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
      <Synthetic Name="&lt;1&gt;" Condition="sizeof($T3) != 0" Optional="true">
        <Expand>
          <ArrayItems>
            <Size>homogeneous_size()</Size>
            <ValuePointer>homogeneous_first01()</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
      <Synthetic Name="&lt;2&gt;" Condition="sizeof($T4) != 0" Optional="true">
        <Expand>
          <ArrayItems>
            <Size>homogeneous_size()</Size>
            <ValuePointer>homogeneous_first02()</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
      <Synthetic Name="&lt;3&gt;" Condition="sizeof($T5) != 0" Optional="true">
        <Expand>
          <ArrayItems>
            <Size>homogeneous_size()</Size>
            <ValuePointer>homogeneous_first03()</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
      <Synthetic Name="&lt;4&gt;" Condition="sizeof($T6) != 0" Optional="true">
        <Expand>
          <ArrayItems>
            <Size>homogeneous_size()</Size>
            <ValuePointer>homogeneous_first04()</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
      <Synthetic Name="&lt;5&gt;" Condition="sizeof($T7) != 0" Optional="true">
        <Expand>
          <ArrayItems>
            <Size>homogeneous_size()</Size>
            <ValuePointer>homogeneous_first05()</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
      <Synthetic Name="&lt;6&gt;" Condition="sizeof($T8) != 0" Optional="true">
        <Expand>
          <ArrayItems>
            <Size>homogeneous_size()</Size>
            <ValuePointer>homogeneous_first06()</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
      <Synthetic Name="&lt;7&gt;" Condition="sizeof($T9) != 0" Optional="true">
        <Expand>
          <ArrayItems>
            <Size>homogeneous_size()</Size>
            <ValuePointer>homogeneous_first07()</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
    </Expand>
  </Type>

