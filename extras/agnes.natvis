    <Intrinsic Name="non_optimized_heterogeneous_ptr_at" Expression="(i == 0) ? impl_.ptrs_.ptr0_ : ((void**)&amp;impl_.ptrs_.ptrs_)[sizeof(impl_.ptrs_.ptrs_)/sizeof(void*) - i]">
